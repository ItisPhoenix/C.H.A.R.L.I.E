# -- LLM ----------------
LLM_URL=your_llm_base_url_here
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=your_llm_model_id
LLM_REASONING_ENABLED=false

# -- LOGGING ---------------------------------------------------------------
# Normal console shows operational state; the rotating file keeps full detail.
CONSOLE_LOG_LEVEL=INFO
FILE_LOG_LEVEL=DEBUG
CONSOLE_DIAGNOSTICS=false

# Use HTTP(S)_PROXY/ALL_PROXY for LLM requests only when explicitly needed.
# LLM_TRUST_ENV=false

# -- SEARCH PROVIDERS ------------------------------------------------------
# SearXNG self-hosted instance (first priority, no API key needed).
# Leave blank to skip. SearXNG is the primary provider; optional providers are fallback adapters.
SEARXNG_URL=http://your-searxng-server:8080
# Optional engine allowlist; empty uses the SearXNG server defaults.
SEARXNG_ENGINES=mojeek
SEARXNG_FALLBACK_ENGINES=
RESEARCH_YACY_ENABLED=false
RESEARCH_YACY_URL=http://your-ubuntu-yacy-host:8090
RESEARCH_YACY_RESOURCE=local
RESEARCH_YACY_VERIFY=cacheonly
RESEARCH_DDG_ENDPOINT=https://html.duckduckgo.com/html/
RESEARCH_BING_ENABLED=true
RESEARCH_BING_ENDPOINT=https://www.bing.com/search
RESEARCH_PROVIDER_ORDER=yacy,bing,searxng
# EXA_API_KEY=your_exa_api_key_here
# TAVILY_API_KEY=your_tavily_api_key_here

# -- WEB RESEARCH ------------------------------------------------------------
# Static requests pin resolved public IPs; Scrapling's dynamic fallback uses
# the same public-address-pinning egress proxy when extraction is thin.
# RESEARCH_ENABLED=true
# RESEARCH_DEFAULT_MODE=auto
# RESEARCH_MARKET=IN
# RESEARCH_CURRENCY=INR
# RESEARCH_LOCALE=en-IN
RESEARCH_CRAWL_ENABLED=true
RESEARCH_DDG_ENABLED=false
# RESEARCH_JINA_ENABLED=false
# RESEARCH_MAX_CONCURRENCY=6
# RESEARCH_MAX_SEARCH_QUERIES=24
# RESEARCH_MAX_SOURCES=40
# RESEARCH_MAX_PAGES_PER_DOMAIN=4
# RESEARCH_CRAWL_MAX_DEPTH=2
# RESEARCH_CRAWL_MAX_PAGES=20
# RESEARCH_FETCH_TIMEOUT_S=20
# RESEARCH_TOTAL_TIMEOUT_QUICK_S=20
# RESEARCH_TOTAL_TIMEOUT_STANDARD_S=75
# RESEARCH_TOTAL_TIMEOUT_DEEP_S=150
# RESEARCH_TOTAL_TIMEOUT_SUSTAINED_S=300
# RESEARCH_SYNTHESIS_RESERVE_QUICK_S=4
# RESEARCH_SYNTHESIS_RESERVE_STANDARD_S=12
# RESEARCH_SYNTHESIS_RESERVE_DEEP_S=20
# RESEARCH_SYNTHESIS_RESERVE_SUSTAINED_S=30
# RESEARCH_MAX_ITERATIONS=6
# RESEARCH_MAX_LLM_CALLS=10
# RESEARCH_MAX_VERIFY_ROUNDS=2
# RESEARCH_SYNTHESIS_MODEL=
# RESEARCH_VERIFY_FETCH_CHARS=60000

# -- HARDWARE / DEVICE SETTINGS ----------------------------------------------
# -1 = System default; >=0 = Specific device index
MIC_INDEX=-1
GPU_DEVICE=cuda

# -- RUNTIME -----------------------------------------------------------------
# onnxruntime log verbosity (0=verbose .. 4=error)
# ORT_LOG_LEVEL=3
# Default UI language tag (BCP-47, e.g. en-US)
# DEFAULT_LANGUAGE=en-US
# TTS language code passed to Kokoro
# KOKORO_LANG=en

# -- SPEECH SETTINGS (ASR/TTS) -----------------------------------------------
# Set false for a text-only runtime; audio devices and models are not opened.
VOICE_ENABLED=true
WHISPER_MODEL=large-v3
KOKORO_VOICE=af_heart
KOKORO_MODEL_DIR=models

# Voice Activity Detection (VAD)
VAD_THRESHOLD=0.25
VAD_SILENCE_TIMEOUT=1.8
PHRASE_MIN_DURATION=0.35
PHRASE_MAX_DURATION=45.0

# ASR accuracy tuning (higher = better quality, slightly more latency)
ASR_BEAM_SIZE=6
ASR_BEST_OF=6
ASR_REPETITION_PENALTY=1.15
VAD_MIN_SPEECH_DURATION_MS=120
VAD_MAX_SPEECH_DURATION_S=60
VAD_MIN_SILENCE_DURATION_MS=1000
VAD_SPEECH_PAD_MS=320

# -- BARGE-IN ----------------------------------------------------------------
ENABLE_BARGE_IN=true

# Enable native JSON tool calling for compatible remote APIs.
# Set to false for local models (Ollama) that use text-based TOOL: parsing.
NATIVE_TOOL_CALLING=true

# Cheap LLM classifier fallback for short phrasings that miss every router.py regex (default off).
ROUTER_CLASSIFIER_ENABLED=false

# World model DB (open threads + machine events), replaces MEMORY/USER/OPINIONS.md
WORLD_MODEL_DB_PATH=world_model.db

# -- MEMORY AND HISTORY ------------------------------------------------------
# MEMORY_FILE=MEMORY.md
# USER_FILE=USER.md
# OPINIONS_FILE=OPINIONS.md
# PROMPT_MEMORY_MAX=2200
# SESSION_DB_PATH=sessions.db

# -- ITERATION BUDGET & COMPRESSION ------------------------------------------
# ITERATION_BUDGET_MAX=20
# CONTEXT_WINDOW=32000
# COMPRESSION_THRESHOLD=0.8
# HISTORY_KEEP_RECENT=6
# HISTORY_SUMMARY_MAX_CHARS=400
# -- WAKE WORD (optional) ---------------------------------------------------
# Enable wake-word detection (hands-free activation)
WAKE_WORD_ENABLED=false
# Path to wake-word classifier ONNX model
WAKE_WORD_MODEL_PATH=charlie/charlie.onnx
# Detection threshold (0.0 - 1.0, higher = fewer false triggers)
WAKE_WORD_THRESHOLD=0.6
# Seconds of inactivity before returning to wake-word listening mode
WAKE_WORD_ACTIVITY_TIMEOUT=600
# Path to audio chime played on wake-word detection (optional)
WAKE_WORD_CHIME_PATH=assets/wake_word_chime.wav

# --- VECTOR MEMORY (optional) ---
# Enable/disable auto-extraction of facts from conversations
# MEMORY_AUTO_EXTRACT=true
# ChromaDB storage path
# MEMORY_DB_PATH=charlie_memory_db
# Semantic similarity threshold (lower = stricter matching)
# MEMORY_RELEVANCE_THRESHOLD=0.3
# Embedding model and service URL
# MEMORY_EMBEDDING_MODEL=nomic-embed-text
# MEMORY_EMBEDDING_URL=http://localhost:11434
# Knowledge-graph SQLite path
# MEMORY_GRAPH_DB=charlie_memory_graph.db
# Seconds between periodic memory consolidation passes
# MEMORY_NUDGE_INTERVAL=180
# Soft cap on stored memory entries before consolidation prunes oldest
# MEMORY_CAPACITY_THRESHOLD=300

# -- AGENTIC OS TOGGLES -----------------------------------------------------
# Enable/disable native desktop control (UIA click/type/invoke/key tools).
# Off by default -- requires uiautomation/pyautogui/pynput installed.
# DESKTOP_CONTROL_ENABLED=false
# Global panic hotkey that halts all desktop motion immediately
# DESKTOP_PANIC_HOTKEY=ctrl+alt+q
# Max desktop actions per turn before auto-halt
# DESKTOP_MAX_ACTIONS=40
# Seconds of no real user input required before an unattended background
# desktop task may start or continue
# DESKTOP_IDLE_THRESHOLD_S=120.0
# Per-turn caps for background tasks (larger than the interactive defaults above)
# BACKGROUND_ITERATION_BUDGET_MAX=40
# BACKGROUND_MAX_ACTIONS=100
# BACKGROUND_MAX_PARALLEL_TASKS=1
# OCR pass merged alongside UIA on every desktop_observe call (needs pytesseract/mss/Pillow)
# DESKTOP_OCR_ENABLED=true
# Path to tesseract binary if not on PATH; blank uses pytesseract's default lookup
# TESSERACT_CMD=

# Controlled browser (Playwright), optional -- off by default, needs `uv sync --extra browser`
# BROWSER_ENABLED=false
# Defaults to %LOCALAPPDATA%\Charlie\browser_profile (outside the repo).
# Visible user-browser profile defaults to %LOCALAPPDATA%\Charlie\browser_user_profile.
# BROWSER_USER_PROFILE_PATH=
# BROWSER_IDLE_TIMEOUT_S=120
# BROWSER_MAX_STEPS=12
# BROWSER_DEADLINE_S=25
# BROWSER_HEADLESS=true
# Long-polling Telegram DM bridge, optional -- off by default, needs `uv sync --extra telegram`
# TELEGRAM_ENABLED=false
# Bot token from @BotFather
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your numeric Telegram user id -- the single owner allowed to DM the bot
# TELEGRAM_USER_ID=0
# BROWSER_WARM_ON_WAKE=true
# Local vision model tier -- separate endpoint from the text LLMs, opt-in only.
# VISION_ENABLED=false
# VISION_LLM_URL=your_llm_base_url_here
# VISION_LLM_KEY=no-key
# VISION_LLM_MODEL=your_llm_model_id
# CPU/RAM percent thresholds for proactive alerts (sustained 3 samples before alerting)
# ALERT_CPU_PCT=95
# ALERT_RAM_PCT=92
# Comma-separated file/dir paths for the proactive file-change watcher; empty disables it
# WATCH_PATHS=

