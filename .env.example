# -- LLM ----------------
LLM_URL=your_llm_base_url_here
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=your_llm_model_id

# ── SEARCH PROVIDERS ──────────────────────────────────────────────────────
# SearXNG self-hosted instance (first priority, no API key needed).
# Leave blank to skip; fallback order: SearXNG → Exa → Tavily → DuckDuckGo.
SEARXNG_URL=http://your-searxng-server:8080
# EXA_API_KEY=your_exa_api_key_here
# TAVILY_API_KEY=your_tavily_api_key_here

# ── HARDWARE / DEVICE SETTINGS ──────────────────────────────────────────────
# -1 = System default; >=0 = Specific device index
MIC_INDEX=-1
GPU_DEVICE=cuda

# ── RUNTIME / SERVER ────────────────────────────────────────────────────────
# Bind host/port for the dashboard web server (localhost-only by default).
# CHARLIE_HOST=127.0.0.1
# CHARLIE_PORT=8000
# onnxruntime log verbosity (0=verbose .. 4=error)
# ORT_LOG_LEVEL=3
# Default UI language tag (BCP-47, e.g. en-US)
# DEFAULT_LANGUAGE=en-US
# Path to the JSON file persisting installed Phase 5 extensions across restarts
# EXTENSIONS_STATE_PATH=extensions_state.json
# TTS language code passed to Kokoro
# KOKORO_LANG=en

# ── SPEECH SETTINGS (ASR/TTS) ───────────────────────────────────────────────
WHISPER_MODEL=large-v3
KOKORO_VOICE=af_heart
KOKORO_MODEL_DIR=models

# Voice Activity Detection (VAD)
VAD_THRESHOLD=0.25
VAD_SILENCE_TIMEOUT=1.5
PHRASE_MIN_DURATION=0.35
PHRASE_MAX_DURATION=45.0

# ASR accuracy tuning (higher = better quality, slightly more latency)
ASR_VAD_THRESHOLD=0.5
ASR_BEAM_SIZE=1
ASR_BEST_OF=1
ASR_REPETITION_PENALTY=1.15
VAD_MIN_SPEECH_DURATION_MS=120
VAD_MAX_SPEECH_DURATION_S=60
VAD_MIN_SILENCE_DURATION_MS=1000
VAD_SPEECH_PAD_MS=320

# ── BARGE-IN ────────────────────────────────────────────────────────────────
ENABLE_BARGE_IN=true

# ── LLM REASONING TOGGLE ─────────────────────────────────────────────────────
# Disable chain-of-thought/reasoning for lower voice latency.
LLM_DISABLE_REASONING=true

# Enable native JSON tool calling for compatible remote APIs.
# Set to false for local models (Ollama) that use text-based TOOL: parsing.
NATIVE_TOOL_CALLING=true

# ── HUGGINGFACE TOKEN (for model downloads) ─────────────────────────────────
# Get yours at: https://huggingface.co/settings/tokens
# HF_TOKEN=your_token_here
# ── MEMORY AND HISTORY ──────────────────────────────────────────────────────
# MEMORY_FILE=MEMORY.md
# USER_FILE=USER.md
# OPINIONS_FILE=OPINIONS.md
# PROJECTS_DIR=projects
# PROMPT_MEMORY_MAX=2200
# SESSION_DB_PATH=sessions.db
# SCRATCHPAD_DB_PATH=scratchpad.db

# ── ITERATION BUDGET & COMPRESSION ──────────────────────────────────────────
# ITERATION_BUDGET_MAX=50
# CONTEXT_WINDOW=32000
# COMPRESSION_SOFT_THRESHOLD=0.5
# COMPRESSION_THRESHOLD=0.85
# HISTORY_KEEP_RECENT=6
# HISTORY_SUMMARY_MAX_CHARS=400
# -- WAKE WORD (optional) ───────────────────────────────────────────────────
# Enable wake-word detection (hands-free activation)
WAKE_WORD_ENABLED=false
# Path to wake-word classifier ONNX model
WAKE_WORD_MODEL_PATH=charlie/charlie.onnx
# Detection threshold (0.0 - 1.0, higher = fewer false triggers)
WAKE_WORD_THRESHOLD=0.6
# Seconds of inactivity before returning to wake-word listening mode
WAKE_WORD_ACTIVITY_TIMEOUT=600
# Path to audio chime played on wake-word detection (optional)
WAKE_WORD_CHIME_PATH=assets/wake_word_chime.wav

# --- VECTOR MEMORY (optional) ---
# Enable/disable auto-extraction of facts from conversations
# MEMORY_AUTO_EXTRACT=true
# ChromaDB storage path
# MEMORY_DB_PATH=charlie_memory_db
# Semantic similarity threshold (lower = stricter matching)
# MEMORY_RELEVANCE_THRESHOLD=0.3
# Embedding model and service URL
# MEMORY_EMBEDDING_MODEL=nomic-embed-text:v1.5
# MEMORY_EMBEDDING_URL=http://localhost:11434
# Seconds between periodic memory consolidation passes
# MEMORY_NUDGE_INTERVAL=180
# Soft cap on stored memory entries before consolidation prunes oldest
# MEMORY_CAPACITY_THRESHOLD=300
 
 # ── AGENTIC OS TOGGLES ─────────────────────────────────────────────────────
 # Enable/disable MCP (Model Context Protocol) client
 # MCP_ENABLED=false
# Comma-separated MCP server specs; each is "name|command|arg1,arg2,...".
# Empty means no servers are started even when MCP_ENABLED=true.
# MCP_SERVERS=
# Alternative to MCP_SERVERS: a standard "mcpServers" JSON config file
# (same format as Claude Desktop/Cursor/VS Code) -- see mcp_config.json.
# Both sources are merged; edit the file directly if you don't want the dashboard.
# MCP_CONFIG_PATH=mcp_config.json
 # Enable/disable Hybrid Plugin system
 # PLUGINS_ENABLED=false
 # Comma-separated directories the plugin filesystem tools may access.
 # Leave blank to restrict plugins to the current working directory only.
 # Set to a bare "*" to lift the sandbox entirely (search/read/write anywhere
 # on any drive) -- only do this if you actually want full-disk access.
 # PLUGIN_ALLOW_DIRS=/path/one,/path/two
# Enable/disable native desktop control (UIA click/type/invoke/key tools).
# Off by default -- requires uiautomation/pyautogui/pynput installed.
# DESKTOP_CONTROL_ENABLED=false
# Global panic hotkey that halts all desktop motion immediately
# DESKTOP_PANIC_HOTKEY=ctrl+alt+q
# Dashboard live-frame feed -- independent of DESKTOP_CONTROL_ENABLED, lets the
# screen-capture preview be turned off separately for privacy.
# DESKTOP_FRAME_CAPTURE_ENABLED=true
# Floating desktop pet window (PySide6 subprocess), Windows-only.
# PET_ENABLED=true
# PET_POSITION_PATH=pet_position.json
# Telegram remote control -- create a bot via @BotFather, paste the token here.
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your numeric Telegram user ID (not @username) -- the bot only responds to this one user.
# TELEGRAM_USER_ID=123456789
# Auto-draft a reusable SKILL.md from any background sub-agent run with 5+ tool
# calls (still gated behind install approval). Off by default -- was drafting
# skills out of routine multi-search research, not just real reusable procedures.
# AUTO_SKILL_GEN_ENABLED=false
# Max desktop actions per turn before auto-halt
# DESKTOP_MAX_ACTIONS=40
# Seconds of no real user input required before an unattended background
# desktop task (H.E.L.M.) may start or continue
# DESKTOP_IDLE_THRESHOLD_S=120.0
# Per-turn caps for background tasks (larger than the interactive defaults above)
# BACKGROUND_ITERATION_BUDGET_MAX=40
# BACKGROUND_MAX_ACTIONS=100
# OCR pass merged alongside UIA on every desktop_observe call (needs pytesseract/mss/Pillow)
# DESKTOP_OCR_ENABLED=true
# Path to tesseract binary if not on PATH; blank uses pytesseract's default lookup
# TESSERACT_CMD=
# Headless browser (Playwright + Chrome), off by default -- requires the browser extra installed.
# BROWSER_ENABLED=false
# BROWSER_PROFILE_PATH=browser_profile
# BROWSER_IDLE_TIMEOUT_S=120
# Step cap and wall-clock deadline on voice; both roughly triple from the dashboard/Telegram.
# BROWSER_MAX_STEPS=3
# BROWSER_DEADLINE_S=25
# BROWSER_HEADLESS=true
# BROWSER_WARM_ON_WAKE=true
# Local vision model tier -- separate endpoint from the text LLMs, opt-in only.
# VISION_ENABLED=false
# VISION_LLM_URL=your_llm_base_url_here
# VISION_LLM_KEY=no-key
# VISION_LLM_MODEL=your_llm_model_id
# VISION_LLM_TIMEOUT_S=120.0
# CPU/RAM percent thresholds for proactive alerts (sustained 3 samples before alerting)
# ALERT_CPU_PCT=95
# ALERT_RAM_PCT=92

