{
  "contract_version": 1,
  "envelope": {
    "optional": ["rationale", "session_id", "task_id", "turn_id"]
  },
  "event_types": {
    "transcript": {"category": "transient", "replay": false, "required": []},
    "thinking": {"category": "progress", "replay": false, "required": []},
    "thinking_update": {"category": "progress", "replay": false, "required": []},
    "token": {"category": "transient", "replay": false, "required": []},
    "response_done": {"category": "acknowledgement", "replay": false, "required": []},
    "speaking_start": {"category": "progress", "replay": false, "required": []},
    "speaking_stop": {"category": "acknowledgement", "replay": false, "required": []},
    "wake_word": {"category": "transient", "replay": false, "required": []},
    "vad_start": {"category": "progress", "replay": false, "required": []},
    "audio_state": {"category": "snapshot", "replay": true, "required": []},
    "mic_state": {"category": "snapshot", "replay": true, "required": []},
    "audio_level": {"category": "progress", "replay": false, "required": []},
    "ptt_start": {"category": "request", "replay": false, "required": []},
    "ptt_stop": {"category": "request", "replay": false, "required": []},
    "ptt_cancel": {"category": "request", "replay": false, "required": []},
    "tool_call": {"category": "request", "replay": false, "required": []},
    "tool_result": {"category": "result", "replay": false, "required": []},
    "tool_approval_request": {"category": "request", "replay": true, "required": ["request_id"]},
    "tool_approval_resolved": {"category": "acknowledgement", "replay": false, "required": ["request_id"]},
    "research_progress": {"category": "progress", "replay": false, "required": []},
    "research_result": {"category": "result", "replay": false, "required": []},
    "session_updated": {"category": "result", "replay": false, "required": []},
    "session_active": {"category": "request", "replay": false, "required": []},
    "system_status": {"category": "snapshot", "replay": true, "required": []},
    "subsystem_health": {"category": "snapshot", "replay": true, "required": []},
    "alert": {"category": "transient", "replay": false, "required": []},
    "log": {"category": "transient", "replay": false, "required": []},
    "desktop_frame": {"category": "transient", "replay": false, "required": []},
    "recovery_proposal": {"category": "request", "replay": false, "required": []},
    "extension_proposed": {"category": "request", "replay": false, "required": []},
    "extension_pending": {"category": "snapshot", "replay": true, "required": []},
    "extension_operation_result": {"category": "result", "replay": false, "required": ["request_id", "operation", "kind", "name", "success", "tool_names"]},
    "background_task": {"category": "progress", "replay": true, "required": []},
    "task_snapshot": {"category": "snapshot", "replay": true, "required": []},
    "tool_snapshot": {"category": "snapshot", "replay": true, "required": ["tools"]},
    "mcp_snapshot": {"category": "snapshot", "replay": true, "required": ["servers"]},
    "mcp_operation_result": {"category": "result", "replay": false, "required": ["request_id", "operation", "success", "server_name"]},
    "memory_operation_result": {"category": "result", "replay": false, "required": ["request_id", "operation", "success"]},
    "charlie_state": {"category": "snapshot", "replay": true, "required": []},
    "result_stored": {"category": "result", "replay": false, "required": []},
    "browser_task_started": {"category": "progress", "replay": false, "required": []},
    "browser_task_done": {"category": "result", "replay": false, "required": []},
    "mcp_status_changed": {"category": "snapshot", "replay": true, "required": []},
    "memory_updated": {"category": "result", "replay": false, "required": []},
    "vision_observed": {"category": "result", "replay": false, "required": []},
    "hud_visibility": {"category": "snapshot", "replay": true, "required": []},
    "terminal_command_result": {"category": "acknowledgement", "replay": false, "required": []},
    "chat": {"category": "transient", "replay": false, "required": []},
    "presentation_intent": {"category": "snapshot", "replay": true, "required": ["id", "kind"]},
    "presentation_update": {"category": "snapshot", "replay": true, "required": ["id", "kind"]},
    "presentation_dismiss": {"category": "acknowledgement", "replay": false, "required": ["id"]},
    "presentation_command": {"category": "request", "replay": false, "required": ["action"], "allowed_values": {"action": ["clear_screen", "focus_task", "dismiss_widget", "summon_hud", "open_conversation"]}},
    "surface_action": {"category": "request", "replay": false, "required": ["surface_id", "action_id"]},
    "self_extension_requested":      {"category": "request",  "replay": false, "required": ["tx_id", "kind"]},
    "self_extension_classified":     {"category": "progress", "replay": false, "required": ["tx_id", "kind"]},
    "self_extension_planned":        {"category": "progress", "replay": false, "required": ["tx_id"]},
    "self_extension_approval_required": {"category": "request", "replay": true,  "required": ["tx_id", "reason"]},
    "self_extension_applying":       {"category": "progress", "replay": false, "required": ["tx_id"]},
    "self_extension_testing":        {"category": "progress", "replay": false, "required": ["tx_id"]},
    "self_extension_health_check":   {"category": "progress", "replay": false, "required": ["tx_id"]},
    "self_extension_restarting":     {"category": "progress", "replay": true,  "required": ["tx_id"]},
    "self_extension_verifying":      {"category": "progress", "replay": false, "required": ["tx_id"]},
    "self_extension_completed":      {"category": "result",   "replay": false, "required": ["tx_id"]},
    "self_extension_result":         {"category": "result",   "replay": false, "required": ["request_id", "status"]},
    "self_extension_failed":         {"category": "result",   "replay": false, "required": ["tx_id", "reason"]},
    "self_extension_rollback_started": {"category": "progress", "replay": false, "required": ["tx_id"]},
    "self_extension_rolled_back":    {"category": "result",   "replay": false, "required": ["tx_id"]}
  }
}
